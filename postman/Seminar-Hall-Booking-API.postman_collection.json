              "raw": "{{baseUrl}}/api/clubs?dept_id={{dept_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clubs"],
              "query": [{ "key": "dept_id", "value": "{{dept_id}}" }]
