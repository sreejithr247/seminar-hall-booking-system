            "description": "Liveness check. Returns `{ \"status\": \"ok\" }`."
          },
          "response": []
        }
      ],
      "description": "No authentication."
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "GET /api/halls",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/halls",
            "description": "List active halls."
          },
          "response": []
        },
        {
          "name": "GET /api/halls/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/halls/{{hall_id}}",
            "description": "Single hall by ID. 404 if not found."
          },
          "response": []
        },
        {
          "name": "GET /api/availability (all halls, single date)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/availability?date={{availability_date}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "availability"],
              "query": [
                {
                  "key": "date",
                  "value": "{{availability_date}}",
                  "description": "Required if not using start_date/end_date. Format YYYY-MM-DD."
                }
              ]
            },
            "description": "When **hall_id** is omitted: returns availability across all halls for **date**.\n\nSet variable `availability_date` or edit the query value."
          },
          "response": []
        },
        {
          "name": "GET /api/availability (one hall, single date)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/availability?hall_id={{hall_id}}&date={{availability_date}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "availability"],
              "query": [
                { "key": "hall_id", "value": "{{hall_id}}" },
                { "key": "date", "value": "{{availability_date}}" }
              ]
            },
            "description": "**hall_id** + **date** (YYYY-MM-DD): bookings/slots for that hall on that day."
          },
          "response": []
        },
        {
          "name": "GET /api/availability (one hall, date range)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/availability?hall_id={{hall_id}}&start_date={{range_start}}&end_date={{range_end}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "availability"],
              "query": [
                { "key": "hall_id", "value": "{{hall_id}}" },
                { "key": "start_date", "value": "{{range_start}}" },
                { "key": "end_date", "value": "{{range_end}}" }
              ]
            },
            "description": "Range mode: **hall_id**, **start_date**, **end_date** (YYYY-MM-DD)."
          },
          "response": []
        },
        {
          "name": "GET /api/departments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/departments",
            "description": "All departments (reference data)."
          },
          "response": []
        },
