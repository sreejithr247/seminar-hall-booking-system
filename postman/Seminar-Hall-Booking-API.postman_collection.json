            "description": "Clubs for a specific department."
          },
          "response": []
        }
      ],
      "description": "Unauthenticated routes."
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "try {",
                  "  var j = pm.response.json();",
                  "  if (j.token) {",
                  "    pm.collectionVariables.set('token', j.token);",
                  "    console.log('Saved token to collection variable token');",
                  "  }",
                  "} catch (e) { console.warn('No JSON token in response'); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"your_username\",\n  \"password\": \"your_password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Body: `username`, `password` (required).\n\nResponse includes `token` (JWT), `user`, and sets HTTP-only cookie `auth_token` in browsers.\n\nTests script stores `token` for Bearer requests."
          },
          "response": []
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Clears `auth_token` cookie (browser). Token variable in Postman is not cleared automatically."
          },
          "response": []
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Current user from JWT. Requesters may also get a `requester` object in the response."
          },
          "response": []
        },
        {
          "name": "PATCH /api/auth/password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"old-password\",\n  \"new_password\": \"new-password-min-6-chars\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/password",
            "description": "**Any authenticated role.** Verify **current_password**, then set **new_password** (min 6 chars). Does not rotate JWT."
          },
          "response": []
        }
      ],
      "description": "Authentication; `/me` requires Bearer token or cookie."
    },
