    {
      "name": "Auth",
      "description": "Login is public. `/me` and `/password` need JWT.",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "try {",
                  "  var j = pm.response.json();",
                  "  if (j.token) {",
                  "    pm.collectionVariables.set('token', j.token);",
                  "    pm.environment.set('token', j.token);",
                  "  }",
                  "  if (j.user && j.user.user_id) {",
                  "    pm.collectionVariables.set('user_id', String(j.user.user_id));",
                  "  }",
                  "  if (j.user && j.user.dept_id) {",
                  "    pm.collectionVariables.set('dept_id', String(j.user.dept_id));",
                  "  }",
                  "} catch (e) { console.warn(e); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "`POST /api/auth/login` — seed admin. Saves `token` (and `user_id` / `dept_id` when present)."
